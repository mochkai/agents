# Agent farm notifications (copy to .env, which is git-ignored, and fill in). Read by bin/notify.sh.
# Recipient of the notification emails; leave empty to only write logs/notifications.log.
# Tip: a Gmail +alias (you+agentfarm@gmail.com) lands in your normal inbox and is easy to filter and label.
NOTIFY_EMAIL=you+agentfarm@example.com
# Events that notify (comma-separated): ready, needs_human
NOTIFY_ON=ready,needs_human
# msmtp account in ~/.msmtprc used to send
MSMTP_ACCOUNT=gmail
# Sender name shown in your inbox
NOTIFY_FROM_NAME=Agent Farm
# Sender address in the From header (default: NOTIFY_EMAIL without the +tag, i.e. your Gmail account)
# NOTIFY_FROM=you@example.com
