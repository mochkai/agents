# Agent farm notifications (copy to .env, which is git-ignored, and fill in). Read by bin/notify.sh.
# Recipient of the notification emails; leave empty to only write logs/notifications.log.
NOTIFY_EMAIL=you@example.com
# Events that notify (comma-separated): ready, needs_human
NOTIFY_ON=ready,needs_human
# msmtp account in ~/.msmtprc used to send
MSMTP_ACCOUNT=gmail
